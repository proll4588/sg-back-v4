generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model Employee {
  id                     Int                      @id @default(autoincrement())
  positionId             Int
  userId                 Int                      @unique(map: "Emplouee_pk_2")
  name                   String                   @db.VarChar(255)
  email                  String                   @db.VarChar(255)
  EmployeePosition       EmployeePosition         @relation(fields: [positionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Emplouee_EmploeePosition_id_fk")
  User                   User                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Emplouee_User_id_fk")
  EmployeeProcessMembers EmployeeProcessMembers[]
  EmployeeTest           EmployeeTest[]

  @@index([positionId], map: "Emplouee_EmploeePosition_id_fk")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model EmployeePosition {
  id       Int        @id @default(autoincrement())
  title    String     @unique(map: "EmploeePosition_pk_2") @db.VarChar(255)
  Employee Employee[]
}

model EmployeeProcessMembers {
  id                    Int                 @id @default(autoincrement())
  employeeTestProcessId Int
  employeeId            Int
  Employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmplyeeProcessMembers_Emplouee_id_fk")
  EmployeeTestProcess   EmployeeTestProcess @relation(fields: [employeeTestProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmplyeeProcessMembers_EmployeeTestProcess_id_fk")

  @@index([employeeId], map: "EmplyeeProcessMembers_Emplouee_id_fk")
  @@index([employeeTestProcessId], map: "EmplyeeProcessMembers_EmployeeTestProcess_id_fk")
}

model EmployeeTest {
  id                    Int                  @id @default(autoincrement())
  employeeId            Int
  employeeTestProcessId Int
  startDate             DateTime             @db.DateTime(0)
  endDate               DateTime?            @db.DateTime(0)
  employeeTestVariantId Int
  EmployeeTestProcess   EmployeeTestProcess  @relation(fields: [employeeTestProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTest_EmployeeTestProcess_id_fk")
  EmployeeTestVariant   EmployeeTestVariant  @relation(fields: [employeeTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTest_EmployeeTestVariant_id_fk")
  Employee              Employee             @relation(fields: [employeeId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTest_Employee_id_fk")
  EmployeeTestAnswer    EmployeeTestAnswer[]

  @@index([employeeTestProcessId], map: "EmployeeTest_EmployeeTestProcess_id_fk")
  @@index([employeeTestVariantId], map: "EmployeeTest_EmployeeTestVariant_id_fk")
  @@index([employeeId], map: "EmployeeTest_Employee_id_fk")
}

model EmployeeTestAnswer {
  id                   Int                  @id @default(autoincrement())
  employeeTestId       Int
  questionId           Int
  answer               Int
  EmployeeTestQuestion EmployeeTestQuestion @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestAnswer_EmployeeTestQuestion_id_fk")
  EmployeeTest         EmployeeTest         @relation(fields: [employeeTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestAnswer_EmployeeTest_id_fk")

  @@index([questionId], map: "EmployeeTestAnswer_EmployeeTestQuestion_id_fk")
  @@index([employeeTestId], map: "EmployeeTestAnswer_EmployeeTest_id_fk")
}

model EmployeeTestBlock {
  id                    Int                    @id @default(autoincrement())
  employeeTestVariantId Int
  title                 String                 @db.VarChar(255)
  EmployeeTestVariant   EmployeeTestVariant    @relation(fields: [employeeTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestBlok_EmployeeTestVariant_id_fk")
  EmployeeTestQuestion  EmployeeTestQuestion[]

  @@index([employeeTestVariantId], map: "EmployeeTestBlok_EmployeeTestVariant_id_fk")
}

model EmployeeTestProcess {
  id                     Int                      @id @default(autoincrement())
  title                  String                   @db.VarChar(255)
  startDate              DateTime                 @db.DateTime(0)
  endDate                DateTime?                @db.DateTime(0)
  startUserId            Int
  employeeTestVariantId  Int
  EmployeeProcessMembers EmployeeProcessMembers[]
  EmployeeTest           EmployeeTest[]
  EmployeeTestVariant    EmployeeTestVariant      @relation(fields: [employeeTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestProcess_EmployeeTestVariant_id_fk")
  User                   User                     @relation(fields: [startUserId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestProcess_User_id_fk")

  @@index([employeeTestVariantId], map: "EmployeeTestProcess_EmployeeTestVariant_id_fk")
  @@index([startUserId], map: "EmployeeTestProcess_User_id_fk")
}

model EmployeeTestQuestion {
  id                    Int                  @id @default(autoincrement())
  position              Int
  title                 String               @db.VarChar(1023)
  employeeTestVariantId Int
  employeeTestBlockId   Int
  EmployeeTestAnswer    EmployeeTestAnswer[]
  EmployeeTestBlock     EmployeeTestBlock    @relation(fields: [employeeTestBlockId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestQuestion_EmployeeTestBlok_id_fk")
  EmployeeTestVariant   EmployeeTestVariant  @relation(fields: [employeeTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "EmployeeTestQuestion_EmployeeTestVariant_id_fk")

  @@index([employeeTestBlockId], map: "EmployeeTestQuestion_EmployeeTestBlok_id_fk")
  @@index([employeeTestVariantId], map: "EmployeeTestQuestion_EmployeeTestVariant_id_fk")
}

model EmployeeTestVariant {
  id                   Int                    @id @default(autoincrement())
  title                String                 @db.VarChar(255)
  EmployeeTest         EmployeeTest[]
  EmployeeTestBlock    EmployeeTestBlock[]
  EmployeeTestProcess  EmployeeTestProcess[]
  EmployeeTestQuestion EmployeeTestQuestion[]
}

model Group {
  id      Int       @id @default(autoincrement())
  title   String    @unique(map: "Group_pk_2") @db.VarChar(50)
  Student Student[]
}

model Role {
  id       Int     @id @default(autoincrement())
  title    String  @unique(map: "Role_pk_2") @db.VarChar(100)
  isCommon Boolean @default(false)
  User     User[]
}

model Student {
  passbookNumber            Int                         @id
  name                      String                      @db.VarChar(100)
  groupId                   Int
  userId                    Int                         @unique(map: "Student_pk")
  Group                     Group                       @relation(fields: [groupId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Student_Group_id_fk")
  User                      User                        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Student_User_id_fk")
  StudentTest               StudentTest[]
  StudentTestProcessMembers StudentTestProcessMembers[]

  @@index([groupId], map: "Student_Group_id_fk")
}

model StudentTest {
  id                     Int                      @id @default(autoincrement())
  passbookNumber         Int
  studentTestProcessId   Int
  dateStart              DateTime                 @db.DateTime(0)
  dateEnd                DateTime?                @db.DateTime(0)
  studentTestVariantId   Int
  StudentTestProcess     StudentTestProcess       @relation(fields: [studentTestProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTest_StudentTestProcess_id_fk")
  StudentTestVariant     StudentTestVariant       @relation(fields: [studentTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTest_StudentTestVariant_id_fk")
  Student                Student                  @relation(fields: [passbookNumber], references: [passbookNumber], onDelete: NoAction, onUpdate: NoAction, map: "StudentTest_Student_passbookNumber_fk")
  StudentTestOneAnswer   StudentTestOneAnswer[]
  StudentTestOneResult   StudentTestOneResult[]
  StudentTestThreeResult StudentTestThreeResult[]
  StudentTestTwoAnswer   StudentTestTwoAnswer[]
  StudentTestTwoResult   StudentTestTwoResult[]

  @@index([studentTestProcessId], map: "StudentTest_StudentTestProcess_id_fk")
  @@index([studentTestVariantId], map: "StudentTest_StudentTestVariant_id_fk")
  @@index([passbookNumber], map: "StudentTest_Student_passbookNumber_fk")
}

model StudentTestOneAnswer {
  id                    Int                 @id @default(autoincrement())
  studentTestId         Int
  studentTestQuestionId Int
  answer                Int
  StudentTestQuestion   StudentTestQuestion @relation(fields: [studentTestQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestOneAnswer_StudentTestQuestion_id_fk")
  StudentTest           StudentTest         @relation(fields: [studentTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestOneAnswer_StudentTest_id_fk")

  @@index([studentTestQuestionId], map: "StudentTestOneAnswer_StudentTestQuestion_id_fk")
  @@index([studentTestId], map: "StudentTestOneAnswer_StudentTest_id_fk")
}

model StudentTestOneLevel {
  id                       Int                        @id @default(autoincrement())
  title                    String                     @db.VarChar(50)
  StudentTestOneResultItem StudentTestOneResultItem[]
}

model StudentTestOneResult {
  id                       Int                        @id @default(autoincrement())
  studentTestId            Int
  StudentTest              StudentTest                @relation(fields: [studentTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestOneResult_StudentTest_id_fk")
  StudentTestOneResultItem StudentTestOneResultItem[]

  @@index([studentTestId], map: "StudentTestOneResult_StudentTest_id_fk")
}

model StudentTestOneResultItem {
  id                     Int                  @id @default(autoincrement())
  studentTestOneResultId Int
  studentTestOneLevelId  Int
  studentTestOneScaleId  Int
  result                 Decimal              @db.Decimal(5, 2)
  StudentTestOneLevel    StudentTestOneLevel  @relation(fields: [studentTestOneLevelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestOneResultItem_StudentTestOneLevel_id_fk")
  StudentTestOneResult   StudentTestOneResult @relation(fields: [studentTestOneResultId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestOneResultItem_StudentTestOneResult_id_fk")
  StudentTestOneScale    StudentTestOneScale  @relation(fields: [studentTestOneScaleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestOneResultItem_StudentTestOneScale_id_fk")

  @@index([studentTestOneLevelId], map: "StudentTestOneResultItem_StudentTestOneLevel_id_fk")
  @@index([studentTestOneResultId], map: "StudentTestOneResultItem_StudentTestOneResult_id_fk")
  @@index([studentTestOneScaleId], map: "StudentTestOneResultItem_StudentTestOneScale_id_fk")
}

model StudentTestOneScale {
  id                       Int                        @id @default(autoincrement())
  title                    String                     @unique(map: "TestOneScale_pk_2") @db.VarChar(100)
  StudentTestOneResultItem StudentTestOneResultItem[]
}

model StudentTestProcess {
  id                        Int                         @id @default(autoincrement())
  userId                    Int
  studentTestVariantId      Int
  dateStart                 DateTime                    @db.DateTime(0)
  dateEnd                   DateTime?                   @db.DateTime(0)
  title                     String                      @unique(map: "StudentTestProcess_pk_2") @db.VarChar(255)
  StudentTest               StudentTest[]
  StudentTestVariant        StudentTestVariant          @relation(fields: [studentTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestProcess_StudentTestVariant_id_fk")
  User                      User                        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestProcess_User_id_fk")
  StudentTestProcessMembers StudentTestProcessMembers[]

  @@index([studentTestVariantId], map: "StudentTestProcess_StudentTestVariant_id_fk")
  @@index([userId], map: "StudentTestProcess_User_id_fk")
}

model StudentTestProcessMembers {
  id                   Int                @id @default(autoincrement())
  studentTestProcessId Int
  passbookNumber       Int
  StudentTestProcess   StudentTestProcess @relation(fields: [studentTestProcessId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestProcessMembers_StudentTestProcess_id_fk")
  Student              Student            @relation(fields: [passbookNumber], references: [passbookNumber], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestProcessMembers_Student_passbookNumber_fk")

  @@index([studentTestProcessId], map: "StudentTestProcessMembers_StudentTestProcess_id_fk")
  @@index([passbookNumber], map: "StudentTestProcessMembers_Student_passbookNumber_fk")
}

model StudentTestQuestion {
  id                   Int                    @id @default(autoincrement())
  title                String                 @db.VarChar(1023)
  studentTestVariantId Int
  position             Int
  StudentTestOneAnswer StudentTestOneAnswer[]
  StudentTestVariant   StudentTestVariant     @relation(fields: [studentTestVariantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestQuestion_StudentTestVariant_id_fk")
  StudentTestTwoAnswer StudentTestTwoAnswer[]

  @@index([studentTestVariantId], map: "StudentTestQuestion_StudentTestVariant_id_fk")
}

model StudentTestThreeResult {
  id                            Int                         @id @default(autoincrement())
  studentTestId                 Int
  studentTestThreeResultTitleId Int
  result                        Decimal                     @db.Decimal(5, 2)
  StudentTestThreeResultTitle   StudentTestThreeResultTitle @relation(fields: [studentTestThreeResultTitleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestThreeResult_StudentTestThreeResultTitle_id_fk")
  StudentTest                   StudentTest                 @relation(fields: [studentTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestThreeResult_StudentTest_id_fk")

  @@index([studentTestThreeResultTitleId], map: "StudentTestThreeResult_StudentTestThreeResultTitle_id_fk")
  @@index([studentTestId], map: "StudentTestThreeResult_StudentTest_id_fk")
}

model StudentTestThreeResultTitle {
  id                     Int                      @id @default(autoincrement())
  title                  String                   @db.VarChar(255)
  StudentTestThreeResult StudentTestThreeResult[]
}

model StudentTestTwoAnswer {
  id                    Int                 @id @default(autoincrement())
  studentTestId         Int
  studentTestQuestionId Int
  answer                Boolean
  StudentTestQuestion   StudentTestQuestion @relation(fields: [studentTestQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestTwoAnswer_StudentTestQuestion_id_fk")
  StudentTest           StudentTest         @relation(fields: [studentTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestTwoAnswer_StudentTest_id_fk")

  @@index([studentTestQuestionId], map: "StudentTestTwoAnswer_StudentTestQuestion_id_fk")
  @@index([studentTestId], map: "StudentTestTwoAnswer_StudentTest_id_fk")
}

model StudentTestTwoResult {
  id            Int         @id @default(autoincrement())
  studentTestId Int
  kom           Decimal     @db.Decimal(5, 2)
  org           Decimal     @db.Decimal(5, 2)
  komResult     Decimal     @db.Decimal(5, 2)
  orgResult     Decimal     @db.Decimal(5, 2)
  StudentTest   StudentTest @relation(fields: [studentTestId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "StudentTestTwoResult___fk")

  @@index([studentTestId], map: "StudentTestTwoResult___fk")
}

model StudentTestVariant {
  id                  Int                   @id @default(autoincrement())
  title               String                @unique(map: "StudentTestVariant_pk_2") @db.VarChar(255)
  StudentTest         StudentTest[]
  StudentTestProcess  StudentTestProcess[]
  StudentTestQuestion StudentTestQuestion[]
}

model User {
  id                  Int                   @id @default(autoincrement())
  login               String                @unique(map: "User_pk_2") @db.VarChar(50)
  password            String                @db.VarChar(255)
  roleId              Int
  Employee            Employee?
  EmployeeTestProcess EmployeeTestProcess[]
  Student             Student?
  StudentTestProcess  StudentTestProcess[]
  Role                Role                  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "User_Role_id_fk")

  @@index([roleId], map: "User_Role_id_fk")
}

model StudentAttestation {
  id             Int      @id @default(autoincrement())
  priod          DateTime @db.DateTime(0)
  formOfStudy    String   @db.VarChar(100)
  controlPeriod  String   @db.VarChar(100)
  passbookNumber Int
  courseTitle    String   @db.VarChar(1000)
  studentName    String   @db.VarChar(1023)
  att1           Int?
  att2           Int?
  att3           Int?
  extra          Int?
  exam           Int?
}
